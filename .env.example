# Twitter API Credentials
# https://developer.twitter.com/en/portal/dashboard adresinden alınabilir
TWITTER_API_KEY=your_api_key_here
TWITTER_API_SECRET=your_api_secret_here
TWITTER_ACCESS_TOKEN=your_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_access_token_secret_here
TWITTER_BEARER_TOKEN=your_bearer_token_here

# OpenAI API Key
# https://platform.openai.com/api-keys adresinden alınabilir
OPENAI_API_KEY=your_openai_api_key_here

# Bot Ayarları
# Tweet atma aralığı (dakika)
TWEET_INTERVAL_MINUTES=60
# Yorum yapma aralığı (dakika)
COMMENT_INTERVAL_MINUTES=30
# Aranacak minimum beğeni sayısı (viral tweet tespiti için)
MIN_LIKES_FOR_VIRAL=100
# Aranacak minimum retweet sayısı
MIN_RETWEETS_FOR_VIRAL=50
