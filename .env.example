# --- Frontend (Vite) ---
# Exposed to the browser. Anon key is safe to ship; RLS protects the data.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase Edge Functions (server-side secrets, set via `supabase secrets set`) ---
# Never expose these to the browser.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID=price_xxx
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Where Stripe sends the user back after checkout / portal.
APP_URL=http://localhost:5173
