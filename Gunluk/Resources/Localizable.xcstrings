            "value": "Observa cómo cambiaron tu felicidad y tu energía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vois comment ton bonheur et ton énergie ont évolué."
          }
        },
        "hi": {
