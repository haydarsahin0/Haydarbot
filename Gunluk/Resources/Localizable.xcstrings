    "Mutluluğun ve enerjin zaman içinde nasıl değişmiş, gör.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شاهد كيف تغيّرت سعادتك وطاقتك مع الوقت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh, wie sich Glück und Energie mit der Zeit verändert haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See how your happiness and energy changed over time."
          }
        },
        "es": {
