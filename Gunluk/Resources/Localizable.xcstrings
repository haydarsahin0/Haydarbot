    "Bu cihazda kimlik doğrulama kurulu değil. Ayarlar'dan Face ID ya da cihaz şifresi tanımlarsan kilidi açabilirsin.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد تحقّق مُعدّ على هذا الجهاز. أضف Face ID أو رمز دخول من الإعدادات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät ist keine Authentifizierung eingerichtet. Richte in den Einstellungen Face ID oder einen Code ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No authentication is set up on this device. Add Face ID or a passcode in Settings to use the lock."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no tiene autenticación configurada. Añade Face ID o un código en Ajustes para usar el bloqueo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune authentification n’est configurée. Ajoute Face ID ou un code dans Réglages pour utiliser le verrouillage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर प्रमाणीकरण सेट नहीं है। लॉक इस्तेमाल करने के लिए सेटिंग्स में Face ID या पासकोड जोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada autentikasi di perangkat ini. Tambahkan Face ID atau kode sandi di Pengaturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna autenticazione è configurata su questo dispositivo. Aggiungi Face ID o un codice in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末では認証が設定されていません。設定でFace IDまたはパスコードを追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 인증이 설정되어 있지 않습니다. 설정에서 Face ID나 암호를 추가하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op dit apparaat is geen verificatie ingesteld. Stel Face ID of een toegangscode in bij Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tym urządzeniu nie skonfigurowano uwierzytelniania. Dodaj Face ID lub kod w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo não tem autenticação configurada. Adicione Face ID ou um código nos Ajustes para usar o bloqueio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом устройстве не настроена аутентификация. Добавьте Face ID или код-пароль в Настройках."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本设备尚未设置身份验证。请在“设置”中添加面容 ID 或密码。"
          }
        }
      }
    },
    "Bu fotoğraf silinsin mi?": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
