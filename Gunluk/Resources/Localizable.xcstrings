    "Bildirimlere izin verilmedi. iPhone Ayarlar → Bildirimler → Günlük yolundan açabilirsin.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإشعارات غير مسموح بها. يمكنك تفعيلها من الإعدادات ← الإشعارات ← المذكرات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind nicht erlaubt. Aktiviere sie unter Einstellungen → Mitteilungen → Tagebuch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications aren’t allowed. You can turn them on in Settings → Notifications → Diary."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas. Actívalas en Ajustes → Notificaciones → Diario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications ne sont pas autorisées. Active-les dans Réglages → Notifications → Journal."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूचनाएँ अनुमत नहीं हैं। सेटिंग्स → सूचनाएँ → डायरी से चालू करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikasi tidak diizinkan. Aktifkan di Pengaturan → Notifikasi → Buku Harian."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche non sono consentite. Attivale in Impostazioni → Notifiche → Diario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知が許可されていません。設定 → 通知 → 日記 からオンにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림이 허용되지 않았습니다. 설정 → 알림 → 일기에서 켤 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen zijn niet toegestaan. Zet ze aan via Instellingen → Berichtgeving → Dagboek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia są wyłączone. Włącz je w Ustawienia → Powiadomienia → Dziennik."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações não estão permitidas. Ative em Ajustes → Notificações → Diário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления запрещены. Включите их в Настройках → Уведомления → Дневник."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知未获授权。可在“设置 → 通知 → 日记”中开启。"
          }
        }
      }
    },
