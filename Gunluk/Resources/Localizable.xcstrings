    "Yazdıkların yalnızca bu cihazda saklanıyor.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما تكتبه يبقى على هذا الجهاز فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du schreibst, bleibt nur auf diesem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you write stays on this device only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que escribes se guarda solo en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que tu écris reste uniquement sur cet appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका लिखा केवल इसी डिवाइस पर रहता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulisanmu hanya disimpan di perangkat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che scrivi resta solo su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書いた内容はこの端末にのみ保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작성한 내용은 이 기기에만 저장됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat je schrijft blijft alleen op dit apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To, co piszesz, zostaje tylko na tym urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você escreve fica apenas neste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Написанное хранится только на этом устройстве."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你写下的内容仅保存在本设备。"
          }
        }
      }
    },
