    "Günlüğün ve fotoğrafların senin iCloud hesabında saklanıyor. Telefonunu değiştirdiğinde ya da uygulamayı yeniden kurduğunda geri geliyor.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ مذكراتك وصورك في حسابك على iCloud، وتعود عند تغيير الهاتف أو إعادة تثبيت التطبيق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Tagebuch und deine Fotos liegen in deinem iCloud-Account. Beim Gerätewechsel oder einer Neuinstallation sind sie wieder da."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your diary and photos are stored in your own iCloud account. They come back when you switch phones or reinstall the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu diario y tus fotos se guardan en tu cuenta de iCloud. Vuelven al cambiar de teléfono o reinstalar la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton journal et tes photos sont stockés dans ton compte iCloud. Ils reviennent si tu changes de téléphone ou réinstalles l’app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी डायरी और तस्वीरें आपके अपने iCloud में रहती हैं। फ़ोन बदलने या ऐप दोबारा इंस्टॉल करने पर वापस आ जाती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buku harian dan fotomu tersimpan di akun iCloud milikmu. Semuanya kembali saat ganti ponsel atau pasang ulang aplikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il diario e le foto sono nel tuo account iCloud. Tornano se cambi telefono o reinstalli l’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日記と写真はあなた自身のiCloudに保存されます。機種変更や再インストールの後も戻ってきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일기와 사진은 사용자의 iCloud에 저장됩니다. 기기를 바꾸거나 앱을 다시 설치해도 돌아옵니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je dagboek en foto’s staan in je eigen iCloud-account. Ze komen terug bij een nieuwe telefoon of herinstallatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój dziennik i zdjęcia są w twoim koncie iCloud. Wrócą po zmianie telefonu lub ponownej instalacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu diário e suas fotos ficam na sua conta do iCloud. Eles voltam ao trocar de telefone ou reinstalar o app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дневник и фотографии хранятся в вашем iCloud. Они вернутся при смене телефона или переустановке."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的日记和照片保存在自己的 iCloud 中。换手机或重装应用后会自动恢复。"
          }
        }
      }
    },
    "Günlüğünü açmak için kimliğini doğrula": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقّق من هويتك لفتح مذكراتك"
          }
        },
