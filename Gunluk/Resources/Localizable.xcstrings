    "Yazmak her zaman ücretsiz. Abonelik geçmiş günlerini okumanı açıyor.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكتابة مجانية دائمًا. الاشتراك يفتح قراءة أيامك السابقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreiben ist immer kostenlos. Das Abo öffnet deine vergangenen Tage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Writing is always free. The subscription unlocks reading your past days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribir siempre es gratis. La suscripción desbloquea la lectura de días pasados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrire est toujours gratuit. L’abonnement ouvre la lecture des jours passés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लिखना हमेशा मुफ़्त है। सदस्यता से पिछले दिन पढ़े जा सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menulis selalu gratis. Langganan membuka bacaan hari-hari lalu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivere è sempre gratis. L’abbonamento sblocca la lettura dei giorni passati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書くのは常に無料です。購読すると過去の日を読めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작성은 언제나 무료입니다. 구독하면 지난 날을 읽을 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijven is altijd gratis. Het abonnement ontgrendelt je eerdere dagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pisanie jest zawsze darmowe. Subskrypcja odblokowuje czytanie minionych dni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escrever é sempre grátis. A assinatura libera a leitura dos dias anteriores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Писать всегда бесплатно. Подписка открывает чтение прошлых дней."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写作永远免费。订阅可解锁阅读过去的日子。"
          }
        }
      }
    },
    "Yazmak, fotoğraf ve ses eklemek her zaman ücretsiz. Abonelik geçmiş günlerini okumanı açıyor.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكتابة وإضافة الصور والصوت مجانية دائمًا. الاشتراك يفتح قراءة الأيام السابقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreiben, Fotos und Sprachnotizen sind immer kostenlos. Das Abo öffnet deine vergangenen Tage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Writing and adding photos and voice are always free. The subscription unlocks reading your past days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribir y añadir fotos y voz siempre es gratis. La suscripción desbloquea leer días pasados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrire, ajouter photos et voix est toujours gratuit. L’abonnement ouvre la lecture des jours passés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लिखना और तस्वीरें व आवाज़ जोड़ना हमेशा मुफ़्त है। सदस्यता पिछले दिनों को पढ़ने की सुविधा देती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menulis serta menambah foto dan suara selalu gratis. Langganan membuka hari-hari lalu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivere e aggiungere foto e voce è sempre gratis. L’abbonamento sblocca i giorni passati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書くこと、写真や音声の追加は常に無料です。購読すると過去の日を読めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작성과 사진·음성 추가는 언제나 무료입니다. 구독하면 지난 날을 읽을 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijven en foto’s en spraak toevoegen is altijd gratis. Het abonnement ontgrendelt eerdere dagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pisanie oraz dodawanie zdjęć i głosu jest zawsze darmowe. Subskrypcja odblokowuje minione dni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escrever e adicionar fotos e voz são sempre grátis. A assinatura libera ler dias anteriores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Писать и добавлять фото и голос всегда бесплатно. Подписка открывает прошлые дни."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写作、添加照片和语音永远免费。订阅可解锁阅读过去的日子。"
          }
        }
      }
    },
    "Yedekleme": {
      "extractionState": "manual",
      "localizations": {
