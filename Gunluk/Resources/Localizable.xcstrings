    "Yedekleme kapalıyken kayıtların yalnızca bu cihazda. Telefonu kaybedersen ya da uygulamayı silersen geri getirilemez.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند إيقاف النسخ الاحتياطي تبقى مدوّناتك على هذا الجهاز فقط، ولا يمكن استرجاعها إذا فقدته أو حذفت التطبيق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Backup liegen deine Einträge nur auf diesem Gerät. Bei Verlust oder Deinstallation sind sie unwiederbringlich weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With backup off, your entries live only on this device. If you lose the phone or delete the app, they cannot be recovered."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con la copia desactivada, tus entradas solo están en este dispositivo. Si lo pierdes o borras la app, no se pueden recuperar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans sauvegarde, tes entrées ne sont que sur cet appareil. En cas de perte ou de désinstallation, elles seront perdues."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैकअप बंद होने पर प्रविष्टियाँ केवल इसी डिवाइस पर रहती हैं। फ़ोन खोने या ऐप हटाने पर वापस नहीं मिलेंगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika cadangan mati, catatanmu hanya ada di perangkat ini. Bila hilang atau aplikasi dihapus, tidak bisa dipulihkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza backup, le tue voci sono solo su questo dispositivo. Se lo perdi o disinstalli l’app, non si recuperano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップがオフだと記録はこの端末だけにあります。紛失やアプリ削除で復元できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업이 꺼져 있으면 기록은 이 기기에만 있습니다. 기기를 잃거나 앱을 지우면 복구할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder back-up staan je notities alleen op dit apparaat. Raak je het kwijt of verwijder je de app, dan zijn ze weg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez kopii zapasowej wpisy są tylko na tym urządzeniu. Po jego utracie lub usunięciu aplikacji nie da się ich odzyskać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com o backup desligado, suas entradas ficam só neste dispositivo. Se perdê-lo ou apagar o app, não há como recuperar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без резервной копии записи есть только на этом устройстве. При потере или удалении приложения их не вернуть."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭备份后，记录只存在于本设备。若手机丢失或卸载应用，将无法恢复。"
          }
        }
      }
    },
    "Yıllar öncesine kadar her günü açıp okuyabilirsin.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح واقرأ كل يوم، حتى قبل سنوات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne und lies jeden Tag, Jahre zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open and read every day, going back years."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre y lee cada día, años atrás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre et relis chaque journée, des années en arrière."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्षों पीछे तक हर दिन खोलकर पढ़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka dan baca setiap hari, hingga bertahun-tahun lalu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri e rileggi ogni giornata, anche di anni fa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何年も前の日まで開いて読めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몇 년 전 기록까지 열어 읽을 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open en lees elke dag, jaren terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz i czytaj każdy dzień sprzed lat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra e leia cada dia, anos atrás."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывайте и читайте любой день за прошедшие годы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以打开并阅读多年前的每一天。"
          }
        }
      }
    },
