      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر التحقق من الشراء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kauf konnte nicht verifiziert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The purchase could not be verified."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar la compra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’achat n’a pas pu être vérifié."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खरीद सत्यापित नहीं हो सकी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelian tidak dapat diverifikasi."
          }
        },
        "it": {
