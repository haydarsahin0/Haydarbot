    "Sağa sola kaydırarak günler arasında geçebilir, bir güne dokunarak açabilirsin.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب يمينًا أو يسارًا للتنقل بين الأيام، والمس يومًا لفتحه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische nach links oder rechts, um zwischen Tagen zu wechseln; tippe auf einen Tag, um ihn zu öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe left or right to move between days, tap a day to open it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza a izquierda o derecha para cambiar de día y toca un día para abrirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balaye vers la gauche ou la droite pour changer de jour, touche un jour pour l’ouvrir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दिनों के बीच जाने के लिए बाएँ-दाएँ स्वाइप करें, खोलने के लिए किसी दिन पर टैप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Geser ke kiri atau kanan untuk berpindah hari, ketuk hari untuk membukanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri a sinistra o a destra per cambiare giorno, tocca un giorno per aprirlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左右にスワイプして日を移動し、日をタップして開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좌우로 쓸어넘겨 날짜를 이동하고, 날짜를 탭해 열 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veeg naar links of rechts om van dag te wisselen, tik op een dag om die te openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuń w lewo lub w prawo, aby zmienić dzień; dotknij dnia, aby go otworzyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize para os lados para trocar de dia e toque em um dia para abri-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проведите влево или вправо, чтобы переключать дни; коснитесь дня, чтобы открыть его."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "左右滑动切换日期，点按某一天即可打开。"
          }
        }
      }
    },
