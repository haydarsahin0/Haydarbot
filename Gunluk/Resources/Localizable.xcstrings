    "Kayıtların bu cihazda ve açıksa senin iCloud hesabında tutuluyor. Hiçbir veri bize ya da üçüncü bir tarafa gönderilmiyor.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى مدوّناتك على هذا الجهاز، وإن فعّلت المزامنة ففي حسابك على iCloud. لا يُرسل شيء إلينا أو إلى أي طرف آخر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Einträge liegen auf diesem Gerät und, falls aktiviert, in deinem eigenen iCloud-Account. Nichts geht an uns oder Dritte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your entries live on this device and, if enabled, in your own iCloud account. Nothing is sent to us or to anyone else."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus entradas se guardan en este dispositivo y, si lo activas, en tu propia cuenta de iCloud. No enviamos nada a nadie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes entrées restent sur cet appareil et, si activé, dans ton propre compte iCloud. Rien ne nous est transmis."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी प्रविष्टियाँ इसी डिवाइस पर और, चालू हो तो, आपके अपने iCloud में रहती हैं। कुछ भी हमें या किसी और को नहीं भेजा जाता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatanmu tersimpan di perangkat ini dan, jika diaktifkan, di akun iCloud milikmu. Tidak ada yang dikirim ke kami atau pihak lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue voci restano su questo dispositivo e, se attivo, nel tuo account iCloud. Nulla viene inviato a noi o ad altri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録はこの端末に、有効ならあなた自身のiCloudにのみ保存されます。当方や第三者には送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록은 이 기기에, 켜져 있다면 사용자의 iCloud에만 저장됩니다. 저희나 제3자에게 전송되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je notities staan op dit apparaat en, indien ingeschakeld, in je eigen iCloud-account. Er gaat niets naar ons of derden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje wpisy są na tym urządzeniu i, jeśli włączysz, na twoim koncie iCloud. Nic nie trafia do nas ani do osób trzecich."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas entradas ficam neste dispositivo e, se ativado, na sua própria conta do iCloud. Nada é enviado a nós ou a terceiros."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши записи хранятся на устройстве и, если включено, в вашем iCloud. Никуда больше они не отправляются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的记录保存在本设备，若开启则同步到你自己的 iCloud。不会发送给我们或任何第三方。"
          }
        }
      }
    },
