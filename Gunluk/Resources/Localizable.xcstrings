            "value": "Impossibile verificare l’acquisto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入を確認できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매를 확인하지 못했습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De aankoop kon niet worden geverifieerd."
          }
        },
        "pl": {
