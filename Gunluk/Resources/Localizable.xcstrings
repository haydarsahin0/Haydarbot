            "state": "translated",
            "value": "幸福度や気力の移り変わりが見えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "행복과 에너지가 어떻게 변했는지 보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
