    "Günleri puanlamaya başlayınca seyri burada göreceksin.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بمجرد أن تبدأ بتقييم أيامك، سيظهر التغيّر هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobald du deine Tage bewertest, erscheint hier der Verlauf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once you start rating your days, the trend will appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando empieces a puntuar tus días, verás aquí la evolución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dès que tu noteras tes journées, la tendance apparaîtra ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप दिनों को आँकना शुरू करेंगे, रुझान यहाँ दिखेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah kamu mulai menilai hari, grafiknya akan muncul di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando inizierai a valutare le giornate, qui vedrai l’andamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日々を採点し始めると、ここに推移が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루를 평가하기 시작하면 추이가 여기에 나타납니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zodra je je dagen beoordeelt, verschijnt hier het verloop."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy zaczniesz oceniać dni, pojawi się tu wykres."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando começar a avaliar seus dias, a evolução aparecerá aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как только вы начнёте оценивать дни, здесь появится динамика."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始为日子打分后，这里会显示变化趋势。"
          }
        }
      }
    },
