    "%@ gününde yazdıklarını okumak için aboneliğe geç.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اشترك لقراءة ما كتبته في %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonniere, um zu lesen, was du am %@ geschrieben hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscribe to read what you wrote on %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suscríbete para leer lo que escribiste el %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonne-toi pour lire ce que tu as écrit le %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को लिखा गया पढ़ने के लिए सदस्यता लें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berlangganan untuk membaca tulisanmu pada %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbonati per leggere ciò che hai scritto il %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に書いた内容を読むには購読してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 쓴 내용을 읽으려면 구독하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonneer om te lezen wat je op %@ schreef."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Subskrybuj, aby przeczytać wpis z %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assine para ler o que você escreveu em %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оформите подписку, чтобы прочитать запись от %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅后可阅读你在 %@ 写下的内容。"
          }
        }
      }
    },
